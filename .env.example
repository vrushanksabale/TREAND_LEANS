# TrendLens — Earth System Trend Detective
# Environment Variables & API Configuration

# Firebase Authentication & Cloud Firestore (Client)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional Backend Python Service Port
BACKEND_PORT=8000
VITE_BACKEND_URL=http://localhost:8000

# NASA Earthdata Login Credentials (Required for restricted DAAC datasets)
# Note: NASA GIBS and NASA POWER public APIs do NOT require any key.
EARTHDATA_USERNAME=your_nasa_username
EARTHDATA_PASSWORD=your_nasa_password
EARTHDATA_TOKEN=optional_nasa_earthdata_token
